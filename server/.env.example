# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Redis (local Docker default, override with Upstash URL for production)
# For Docker Compose: redis://:your_password@redis:6379
REDIS_URL=redis://localhost:6379

# Filebase Storage (S3 API - For file uploads and self-destruct)
FILEBASE_KEY=your_filebase_access_key_here
FILEBASE_SECRET=your_filebase_secret_key_here
FILEBASE_BUCKET=your_bucket_name
FILEBASE_PUBLIC_URL=https://your-bucket.s3.filebase.com

# Groq AI (for file summarization)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cron cleanup secret (set a strong random string)
CRON_SECRET=your_cron_secret_here

# Frontend URL (for production CORS)
# FRONTEND_URL=https://your-frontend-domain.com
